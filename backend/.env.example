APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Next.js (or other SPA) — used after Google OAuth redirect and as the default Xendit success/failure redirect
# when checkout_return_base is missing or rejected. MUST be your real public SPA URL in production
# (e.g. https://anti-scamph.com), not http://127.0.0.1:3000 — or paid users return to localhost after Xendit.
FRONTEND_URL=http://127.0.0.1:3000

# Optional: extra hostnames allowed for subscription and booking checkout return URLs when the SPA
# sends checkout_return_base (same host as the logged-in session). localhost, 127.0.0.1,
# *.localhost, subdomains of FRONTEND_URL's host, and FRONTEND_URL's host itself are already allowed.
# CHECKOUT_RETURN_HOSTS=app.example.com,staging.example.com

# Comma-separated origins for browser API calls (CORS)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Google OAuth (Laravel Socialite). Authorized redirect URI in Google Console:
# {APP_URL}/auth/google/callback  e.g. http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# User uploads: "public" = local disk + /storage URLs; "s3" = Cloudflare R2 (configure AWS_* below).
# IMPORTANT: variable name is MEDIA_DISK (with a K) — MEDIA_DIS is ignored and uploads use local public disk.
# MEDIA_DISK=public
# Windows/local cURL SSL for R2/S3 (error 60): path to cacert.pem, or false for local only. Unset on local defaults to false.
# AWS_HTTP_VERIFY=false

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional override. Default: {FRONTEND_URL}/mainlogo.png (embedded inline in outgoing mail).
# BIMI DNS logo.svg is generated from mainlogo.png via: php scripts/build-bimi-logo.php
MAIL_BRAND_LOGO_URL=
MAIL_SUPPORT_EMAIL="${MAIL_FROM_ADDRESS}"
MAIL_TRADEMARK_LINE="Anti-Scam PH is a product and service operated by The Rising 2 Brothers OPC."
# Dispatch branded transactional mail (booking, terms, subscriptions) to the queue when true.
MAIL_QUEUE_TRANSACTIONAL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Use "auto" for Cloudflare R2; us-east-1 is typical for AWS S3.
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# S3 / R2 API endpoint (required for R2; omit for default AWS S3).
AWS_ENDPOINT=
# Public object URL base (R2 custom domain or CDN); used by the s3 disk url() helper.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3/R2 HTTP timeouts (seconds) — prevents PHP-FPM workers hanging on slow storage.
# AWS_HTTP_CONNECT_TIMEOUT=10
# AWS_HTTP_TIMEOUT=90
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Card auto-renewal (Visa/Mastercard/JCB). Requires Xendit Recurring product + webhook below.
# XENDIT_RECURRING_ENABLED=false
# XENDIT_RECURRING_WEBHOOK_TOKEN=
# XENDIT_RECURRING_API_VERSION=2026-01-01
# Comma-separated manual-renewal payment methods (non-card checkout)
# XENDIT_MANUAL_PAYMENT_METHODS=GCASH,GRABPAY,SHOPEEPAY,PAYMAYA,QRPH
# Windows/local cURL SSL (error 60): path to https://curl.se/ca/cacert.pem — or false for local only
# XENDIT_HTTP_VERIFY=C:\path\to\cacert.pem
# DANGEROUS (local only): auto-mark payments as paid without real Xendit checkout/webhook
# XENDIT_ALLOW_MOCK_PAID=false
# Optional local-only fallback for forbidden key (403). Keep false for real payment behavior.
# XENDIT_LOCAL_MOCK_ON_FORBIDDEN=false
# GCash channel for marketer commission payouts (Create Payout API)
# XENDIT_PAYOUT_CHANNEL_CODE=PH_GCASH

# --- Pricing pilot (disable before real customers) ---
# Forces flat Xendit amounts (default ₱1) for guest reservation fee, subscription prepay, and room add-ons.
# Mirror on Next.js: NEXT_PUBLIC_PRICING_PILOT_MODE / NEXT_PUBLIC_PRICING_PILOT_AMOUNT
# PRICING_PILOT_MODE=false
# PRICING_PILOT_AMOUNT=1

# Marketing partner GCash payouts via Xendit (disabled by default — enable only when ready)
# MARKETING_PAYOUT_ENABLED=false
# MARKETING_PAYOUT_MIN_PHP=1
# Optional: refuse auto-payout if net batch exceeds this PHP (ops safety valve)
# MARKETING_PAYOUT_MAX_NET_PHP=500000
# MARKETING_PAYOUT_STALE_PENDING_HOURS=72
# MARKETING_PAYOUT_STALE_SUBMITTED_HOURS=168
# Hourly job: retry idempotent Xendit create on stuck pending_submit + poll GET for submitted batches
# MARKETING_PAYOUT_RECONCILE_POLL=true
# MARKETING_PAYOUT_RECOVER_PENDING_MINUTES=3
# MARKETING_PAYOUT_POLL_SUBMITTED_MINUTES=30
# MARKETING_PAYOUT_TIMEZONE=Asia/Manila
# Withholding before disbursement (0.10 = 10% retained for taxes/fees; partner receives 90%)
# MARKETING_PAYOUT_WITHHOLDING_RATE=0.10
# Register webhook: POST {APP_URL}/api/v1/webhooks/xendit/payout (payout.succeeded / payout.failed)
# Optional expired/failed-only: POST {APP_URL}/expired_xendit_ph.php (or /api/v1/webhooks/xendit/expired-ph)

# --- Disbursement hardening (recommended for production) ---
# Hard cap on how many times a stuck batch will be re-POSTed to Xendit (same idempotency key).
# After this, the batch stays in pending_submit and stops auto-retrying (ops must triage).
# MARKETING_PAYOUT_MAX_SUBMIT_ATTEMPTS=8
# Exponential backoff base (minutes): wait = base * 2^(attempts-1), capped at 24h.
# MARKETING_PAYOUT_RETRY_BACKOFF_MINUTES=5
# Block payout if marketer has not uploaded a government-ID document (BSP Circular 1108 KYC).
# MARKETING_PAYOUT_REQUIRE_KYC=true
# Block payout if GCash holder name does not look like the marketer name (money-mule guard).
# Threshold is similar_text percentage; default 70.
# MARKETING_PAYOUT_REQUIRE_NAME_MATCH=true
# MARKETING_PAYOUT_NAME_MATCH_THRESHOLD=70
# Four-eyes principle: net payouts above this PHP threshold require a manual approval row.
# (Wire up in your admin UI; service treats null/0 as disabled.)
# MARKETING_PAYOUT_FOUR_EYES_PHP=50000

VITE_APP_NAME="${APP_NAME}"
