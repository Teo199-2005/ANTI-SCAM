NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production apex domain (no protocol). Used so middleware knows `{tenant}.example.com` vs `example.com`.
# Example: anti-scamph.com — omit only if you do not use per-resort subdomains on this deploy.
# NEXT_PUBLIC_ROOT_DOMAIN=anti-scamph.com

# Set to "true" to show the floating demo quick-login panel on /login in production builds.
# In development it is always shown (after php artisan db:seed).
# NEXT_PUBLIC_SHOW_DEMO_QUICK_LOGIN=true

# Optional: Laravel web origin (Google OAuth uses /auth/google/* on this host).
# If unset, the value is derived by stripping /api/v1 from NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_LARAVEL_URL=http://127.0.0.1:8000
