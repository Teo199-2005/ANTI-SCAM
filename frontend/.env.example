# Laravel JSON API root (must end up at …/api/v1). You may set only the origin, e.g. http://127.0.0.1:8000 — the app appends /api/v1 automatically.
# Browser catalog calls use NEXT_PUBLIC_* on localhost; on a real hostname the app uses same-origin `/api/public/*` (see `laravelApiV1BaseUrl()`).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Pilot pricing (must match backend PRICING_PILOT_* when testing live Xendit at ₱1 per checkout). Disable for production.
# NEXT_PUBLIC_PRICING_PILOT_MODE=true
# NEXT_PUBLIC_PRICING_PILOT_AMOUNT=1

# Quick local setup: copy `env.local.sample` → `.env.local` and adjust ports if needed.
#
# Production VPS: do NOT leave a dev `frontend/.env.local` on the server — Next.js loads it for `next build`
# and `next start` and it overrides `.env.production` for the same keys (you will see both in the build log).
# Symptom: BFF keeps calling http://127.0.0.1:8000 while .env.production has https://your-domain/...
# Symptom: referral "Verify" or subscribe shows 403 + Cloudflare in the error — LARAVEL_API_BASE_URL must NOT be your
#   public https domain (Node hits Cloudflare and gets an HTML challenge). Use loopback / internal PHP only (examples below).

# ── Server-only: Next.js BFF (REQUIRED on VPS) ───────────────────────────────
# `/api/auth/login`, `/api/auth/me`, `/api/backend/*` run in Node and call Laravel with **this** URL
# from the server (loopback / internal network) — NOT the visitor’s browser.
# If unset, defaults to http://127.0.0.1:8000/api/v1 — wrong for most nginx+PHP-FPM setups → 502 on sign-in.
# Examples (pick the URL that works from the same machine as `next start` / PM2):
#   LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api/v1   ← if `php artisan serve` / PM2 listens on 8000
#   LARAVEL_API_BASE_URL=http://127.0.0.1:8080/api/v1   ← if you add loopback-only nginx for Laravel (see deployment/nginx-laravel-loopback.example.conf)
#   LARAVEL_API_BASE_URL=http://127.0.0.1/api/v1        ← only if your :80 default server routes /api/* to Laravel public/
# If `curl http://127.0.0.1/api/v1/auth/login` returns nginx HTML "404 Not Found", nothing is serving
# Laravel at that path on port 80 — try :8000, or deploy the loopback :8080 vhost, or fix nginx to pass /api to PHP.
# Smoke-test: curl -sS -H "Accept: application/json" -X POST "$BASE/auth/login" -H "Content-Type: application/json" -d '{"email":"x@y.com","password":"bad"}'  (expect JSON 401/422, not HTML 404)
# After editing env for PM2: pm2 restart anti-scam-frontend --update-env  (or restart the process so `process.env` reloads)
# Typing `LARAVEL_API_BASE_URL=...` only in an SSH shell does not change PM2 — put the line in frontend/.env.production (or .env.local on the VPS) or in your PM2 ecosystem `env` block.
# Route handlers resolve the Laravel base on each request (not at build time); after changing only env, `pm2 restart` is enough once this codebase is deployed.
# LARAVEL_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public site URL (https, no trailing slash). Required for correct Open Graph / Twitter cards, sitemap, and JSON-LD in production.
# Example: https://anti-scamph.com
# NEXT_PUBLIC_SITE_URL=https://anti-scamph.com

# Production apex domain (no protocol). Optional: enables `{tenant}.example.com` → `/resort/{tenant}` rewrite in middleware (needs wildcard DNS).
# Owner “public link” in the dashboard uses `https://example.com/resort/{tenant}` so it works with only an apex A record.
# Local dev: use http://{tenant}.localhost:3000 (no env needed).
# NEXT_PUBLIC_ROOT_DOMAIN=anti-scamph.com

# Demo accounts panel on /login: only in `next dev`, localhost / 127.* / *.localhost with `next start`,
# or Vercel preview (NEXT_PUBLIC_VERCEL_ENV=preview). Hidden on production VPS/public domains.

# Optional: Laravel web origin (Google OAuth uses /auth/google/* on this host).
# If unset, the value is derived by stripping /api/v1 from NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_LARAVEL_URL=http://127.0.0.1:8000

# Optional: R2 / CDN public base (same value as backend AWS_URL). Used by /api/media-fetch allowlist when
# loading arbitrary image URLs in the crop editor. Profile media editor prefers /api/backend/resort-owner/profile-media/*.
# AWS_URL=https://files.your-domain.com
# NEXT_PUBLIC_AWS_URL=https://files.your-domain.com
# MEDIA_FETCH_ALLOWED_HOSTS=files.your-domain.com

# Optional: Google Maps JavaScript API key for the resort owner profile map pin picker (drag / click to set coordinates).
# Enable Maps JavaScript API and Geocoding API on this same browser key so the map can recenter when province + city are selected.
# Restrict the key by HTTP referrer to your Next dev/prod origins. Public guest map embeds do not require this key.
# Local tenant URLs use subdomains of localhost (e.g. http://azure-sands-1.localhost:3000) — add referrer pattern
# http://*.localhost:3000/* (and http://localhost:3000/*) in Google Cloud or the map will show "didn't load correctly".
# RefererNotAllowedMapError: use http (not https) for localhost and include /* so /dashboard/... paths match.
# If you open the app as http://TENANT.localhost:3000 (not http://localhost:3000), also add HTTP referrer
# http://*.localhost:3000/* — "http://localhost:3000/*" alone does NOT match tenant subdomains of localhost.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
