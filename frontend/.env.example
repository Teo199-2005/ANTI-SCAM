NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public site URL (https, no trailing slash). Required for correct Open Graph / Twitter cards, sitemap, and JSON-LD in production.
# Example: https://anti-scamph.com
# NEXT_PUBLIC_SITE_URL=https://anti-scamph.com

# Production apex domain (no protocol). Used so middleware knows `{tenant}.example.com` vs `example.com`.
# Rewrites to internal path /stay/{tenant} (avoids collision with marketing /resorts/[id]).
# Local dev without this: use http://{tenant}.localhost:3000
# Example: anti-scamph.com — omit only if you do not use per-resort subdomains on this deploy.
# NEXT_PUBLIC_ROOT_DOMAIN=anti-scamph.com

# Demo accounts panel on /login: on in `next dev`; on `next start` when hostname is localhost / 127.* / *.localhost;
# on Vercel when NEXT_PUBLIC_VERCEL_ENV=preview; OR set this to true and rebuild (staging / internal demos).
# NEXT_PUBLIC_SHOW_DEMO_QUICK_LOGIN=true

# Optional: Laravel web origin (Google OAuth uses /auth/google/* on this host).
# If unset, the value is derived by stripping /api/v1 from NEXT_PUBLIC_API_BASE_URL.
# NEXT_PUBLIC_LARAVEL_URL=http://127.0.0.1:8000
